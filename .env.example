# Copy to .env and fill in. .env is gitignored; this file is not.

# --- LLM providers -------------------------------------------------------
# Google is tried first, Groq is the fallback cascade. Both are required.
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# --- Slack ---------------------------------------------------------------
# Bot token. Scopes: channels:read, channels:history, chat:write
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# --- Notion --------------------------------------------------------------
# Internal integration token. Each page or database must be shared with the
# integration explicitly, or it stays invisible to the API.
NOTION_API_KEY=secret_your_notion_internal_integration_token

# --- Airtable ------------------------------------------------------------
# Personal access token with data.records:read and data.records:write
AIRTABLE_PAT=pat_your_airtable_personal_access_token

# --- Discord -------------------------------------------------------------
# Bot token. The bot needs View Channel, Send Messages, Read Message History.
DISCORD_BOT_TOKEN=your_discord_bot_token

# --- Jira ----------------------------------------------------------------
# Tools take the site domain as a parameter, so only credentials belong here.
JIRA_EMAIL=your_jira_account_email@domain.com
JIRA_API_TOKEN=your_jira_api_token
